{
  "name": "sarmadgardeziwp",
  "version": "1.0.0",
  "description": "Custom Classic WordPress Theme and Companion Plugin for sarmadgardezi.com",
  "private": true,
  "scripts": {
    "build:css": "sass sarmadgardezi/assets/scss/main.scss sarmadgardezi/assets/css/main.min.css --style=compressed --no-source-map",
