{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "palette": [
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "surface",
          "color": "#f8fafc",
          "name": "Surface"
        },
        {
          "slug": "text",
          "color": "#0f172a",
          "name": "Text Main"
        },
        {
          "slug": "text-muted",
          "color": "#64748b",
          "name": "Text Muted"
        },
        {
          "slug": "border",
          "color": "#e2e8f0",
          "name": "Border"
        },
        {
          "slug": "primary",
          "color": "#0f172a",
          "name": "Primary"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Sans",
          "slug": "sans"
        },
        {
          "fontFamily": "'JetBrains Mono', monospace",
          "name": "Mono",
          "slug": "mono"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "lineHeight": "1.6"
    }
  }
}
